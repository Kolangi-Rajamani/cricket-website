{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend Server",
      "type": "shell",
      "command": "node server.js",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "cricbuzz",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start Frontend App",
      "type": "shell",
      "command": "npm.cmd run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "cricbuzz",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Cricbuzz App (Backend + Frontend)",
      "dependsOn": [
        "Start Backend Server",
        "Start Frontend App"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
